# Merchant by GrowIOTA: Production & Staging Environment Variables (merchant.growiota.in)

# -----------------------------------------------------------------------------
# 1. Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
DATABASE_PATH=./merchant.db
# Set to true to load the demo merchants when NODE_ENV=production (needed for hosted demos)
SEED_DEMO_DATA=
JWT_SECRET=merchant-growiota-production-secret-key-2026

# -----------------------------------------------------------------------------
# 2. Sarvam AI Integration (Multilingual Voice Agent)
# -----------------------------------------------------------------------------
# Get your API subscription key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=""
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_LLM_MODEL=sarvam-105b
# With only SARVAM_API_KEY set, Sarvam handles speech AND the agent's reasoning.
# Check what the server actually loaded: GET /api/voice/diagnostics?live=1

# -----------------------------------------------------------------------------
# 3. Paytm Gateway & Merchant Edge Integration
# -----------------------------------------------------------------------------
# Authorized merchant credentials from Paytm Merchant Dashboard
PAYTM_MID=""
PAYTM_MERCHANT_KEY=""
PAYTM_CLIENT_ID=""
PAYTM_CLIENT_SECRET=""
PAYTM_ENVIRONMENT=STAGE # STAGE or PROD
PAYTM_WEBHOOK_SECRET=paytm-webhook-verification-secret

# -----------------------------------------------------------------------------
# 4. Optional Fallback LLM Services
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
# Model used when GEMINI_API_KEY is set (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Which LLM to try first when both keys are set: gemini or sarvam (default: gemini, then sarvam)
LLM_PROVIDER=
